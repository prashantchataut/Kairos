<resources>
    <style name="Theme.Kairos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Kairos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kairos</item>
    </style>
</resources>
