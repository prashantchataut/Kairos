    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tile -->
    <path
        android:pathData="M12,12 h84 a30,30 0 0 1 30,30 v24 a30,30 0 0 1 -30,30 h-84 a30,30 0 0 1 -30,-30 v-24 a30,30 0 0 1 30,-30 z"
        android:fillColor="#2E5BFF" />

    <!-- Stem -->
    <path
        android:pathData="M34,34 L34,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Upper arm -->
    <path
        android:pathData="M34,42 L66,32"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Lower arm -->
    <path
        android:pathData="M34,52 L60,71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Moment dot -->
    <path
        android:pathData="M74,78 m-7,0 a7,7 0 1 0 14,0 a7,7 0 1 0 -14,0 z"
        android:fillColor="#FFFFFF" />

    <!-- Motion trail -->
    <path
        android:pathData="M78,82 L88,90"
        android:strokeColor="#B8C7FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
