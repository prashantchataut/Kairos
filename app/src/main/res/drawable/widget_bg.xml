<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#FFD6E6FF" android:centerColor="#FFF3EEFF" android:endColor="#FFFFE3EA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:type="radial" android:gradientRadius="160dp" android:centerX="0.1" android:centerY="0.95" android:startColor="#99C6F2DE" android:endColor="#00C6F2DE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</layer-list>
